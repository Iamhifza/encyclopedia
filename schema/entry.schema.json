{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/ai-computing-encyclopedia/schema/entry.schema.json",
  "title": "Encyclopedia Entry",
  "description": "Front-matter contract for a canonical entry in content/entries/<slug>.md. One canonical entry per concept; category membership and relations provide the many access paths.",
  "type": "object",
  "required": [
    "term",
    "category",
    "status",
    "difficulty",
    "one_liner",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Canonical display name, e.g. 'KV Cache'."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Acronyms, synonyms, alternate spellings, historical names. Every alias is redirected to this entry by the A-Z index and search."
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Slug of a top-level domain declared in content/taxonomy.yaml."
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Slug of a subcategory declared under the parent category in content/taxonomy.yaml."
    },
    "status": {
      "type": "string",
      "enum": [
        "foundational",
        "established",
        "modern",
        "emerging",
        "experimental",
        "informal",
        "slang",
        "marketing",
        "contested",
        "historical",
        "deprecated"
      ],
      "description": "How settled the term is. 'contested' means the field genuinely disagrees on the definition; say so in the body rather than inventing consensus."
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "research"
      ]
    },
    "depth": {
      "type": "string",
      "enum": [
        "seed",
        "full"
      ],
      "default": "full",
      "description": "'seed' is a dictionary-level record: canonical name, aliases, one-line definition and relations, with no prose body. It appears in search, the A-Z index, topic pages and the concept graph. 'full' is the complete encyclopedia treatment described in CONTRIBUTING.md. Seeds are promoted to full over time; `enc todo` lists them."
    },
    "one_liner": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "description": "One extremely simple sentence. Rendered as the 'One-Line Definition' section and used in indexes, tooltips and search results, so it must stand alone."
    },
    "diagram": {
      "$ref": "#/$defs/diagram"
    },
    "diagrams": {
      "type": "array",
      "description": "Additional diagrams, each optionally anchored to its own section. Use this when one entry needs more than one figure — a process in 'How Does It Work?' and a lineage rail in 'Evolution', say.",
      "items": {
        "$ref": "#/$defs/diagram"
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100,
          "description": "Year the concept originated. The lower bound accommodates pre-computing mathematics (Bayes, 1763) that the encyclopedia legitimately covers."
        },
        "circa": {
          "type": "boolean",
          "description": "Set true when the year is approximate or the term emerged gradually."
        },
        "attribution": {
          "type": "string",
          "description": "Who or what introduced it: paper, lab, product, community."
        }
      }
    },
    "historical_period": {
      "type": "string",
      "enum": [
        "pre-computing",
        "early-computing",
        "classical-ai",
        "ai-winter",
        "statistical-ml",
        "deep-learning",
        "transformer",
        "foundation-model",
        "agentic"
      ],
      "description": "Era the concept belongs to; drives the timeline view."
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "Pedagogical prerequisites: read these first. Must be acyclic."
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Typed edges of the concept graph. Values are entry slugs.",
      "properties": {
        "is_a": {
          "$ref": "#/$defs/slugList"
        },
        "part_of": {
          "$ref": "#/$defs/slugList"
        },
        "depends_on": {
          "$ref": "#/$defs/slugList"
        },
        "used_by": {
          "$ref": "#/$defs/slugList"
        },
        "solves": {
          "$ref": "#/$defs/slugList"
        },
        "alternative_to": {
          "$ref": "#/$defs/slugList"
        },
        "different_from": {
          "$ref": "#/$defs/slugList"
        },
        "similar_to": {
          "$ref": "#/$defs/slugList"
        },
        "evolved_into": {
          "$ref": "#/$defs/slugList"
        },
        "predecessor_of": {
          "$ref": "#/$defs/slugList"
        },
        "successor_of": {
          "$ref": "#/$defs/slugList"
        },
        "implemented_by": {
          "$ref": "#/$defs/slugList"
        },
        "related_to": {
          "$ref": "#/$defs/slugList"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "encountered_in": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "research-papers",
          "github",
          "production-systems",
          "job-descriptions",
          "interviews",
          "ai-coding-tools",
          "conferences",
          "technical-blogs",
          "documentation",
          "social-media",
          "standards"
        ]
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "description": "Ordered best-first. Prefer primary sources: papers, specs, official docs, official repositories.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "paper",
              "spec",
              "docs",
              "repo",
              "report",
              "book",
              "post",
              "talk",
              "thread"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "year": {
            "type": "integer",
            "minimum": 1600,
            "maximum": 2100
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "description": "Curated video resources. Prefer a named creator and a specific title over a generic search. Links are checked monthly by `enc lint-links`.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "channel"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "disputed": {
      "type": "boolean",
      "description": "True when practitioners actively use the term with incompatible meanings. Renders a caution admonition."
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date this entry was last reviewed for accuracy. Fast-moving terms should be re-reviewed often."
    },
    "review_by": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Optional re-review deadline. The stale report lists entries past this date."
    }
  },
  "$defs": {
    "slugList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "visual": {
      "type": "object",
      "description": "One picture. `kind` chooses the primitive; the remaining keys belong to that primitive and are checked in Python against diagrams.VISUAL_KEYS, which is the single source of truth.",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "grid",
            "bars",
            "fan",
            "chips",
            "stack",
            "columns",
            "table",
            "segments",
            "plot",
            "passes",
            "pipeline",
            "mapping",
            "matrix",
            "scatter",
            "tree",
            "lineage"
          ]
        },
        "caption": {
          "type": "string"
        },
        "width": {
          "type": "number"
        }
      }
    },
    "diagram": {
      "type": "object",
      "description": "A declarative diagram rendered to themed SVG. It sits at the top of 'How Does It Work?' unless `section` names another heading. Prefer a figure over an ASCII block wherever the shape of the thing is the explanation.",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "steps",
            "flow",
            "figure"
          ]
        },
        "title": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "Heading this figure belongs under. Defaults to 'How Does It Work?'. The section must exist on the entry or validation fails."
        },
        "footer": {
          "type": "string"
        },
        "loop": {
          "type": "string",
          "description": "Label for a return arrow, for cyclical processes."
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "notes": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "label",
                        "text"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "visual": {
                "$ref": "#/$defs/visual"
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "accent": {
                "type": "boolean"
              },
              "tone": {
                "type": "string",
                "enum": [
                  "accent",
                  "warn",
                  "bad",
                  "ok",
                  "muted"
                ]
              }
            }
          }
        }
      }
    }
  }
}
